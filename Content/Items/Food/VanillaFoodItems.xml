<?xml version="1.0" encoding="utf-8"?>

  <!-- Overriding all the vanilla food items so they self-delete as soon as they appear.
  Also remove their tags, fabrication, deconstruction... so they don't appear at all in any way
  Change the sprite to something vanilla otherwise we'll get errors
  We do not want monsters directly dropping meat as they do in vanilla, so the items need to be gone entirely.
  If we want to integrate some of the vanilla items, we'll make a "he-fooditem" copy with nameidentifier instead -->

<!-- 
  List of tags used:
  monsterfood           is eaten by monsters in the ranching foodthrough, can be used to bait fish as well   
  vanillafooditem       food items from vanilla, the DLC uses an extension to add "nourished" affliction
  fooditem              generic tag that doesn't seem to be used anywhere except one event
  basicfooditem         is generated by "basicfood" resource? I don't know how that works 
  luxuryfooditem        Counts as "luxuryfood", again I don't know what it does
  mixedfooditem         Counts as "luxuryfood", again I don't know what it does
  edibleplantitem       any edible plant, currently has no use
  rawplantitem          is generated by "rawplant" resource? I don't know how that works    
  cookedplantitem       is generated by "basicfood" resource? I don't know how that works  
  biofuelprocessable    can be used in the biofuel reactor
  rawfishitem           is generated by "basicfood" resource? I don't know how that works  
  cookedfishitem        is generated by "basicfood" resource? I don't know how that works 

 -->



<Override>
<Items>

  <!-- Humanmeat and Monstermeat are from vanilla baro, the rest is from the DLC -->

  <!-- ****************************************************************************************************************************************************** -->
  <!-- 'Food' items from deconstructing -->
  <!-- ****************************************************************************************************************************************************** -->
  <!-- "Human Meat" -->
  <Item name="" identifier="humanmeat" tags="smallitem" category="Misc" subcategory="food" hideinmenus="true">
    <Sprite texture="Content/Items/InventoryIconAtlas2.png" sourcerect="512,128,64,64" origin="0.5,0.5" />
    <Body radius="12" height="20" density="10.5" />
    <Holdable canBeCombined="true" removeOnCombined="true" characterusable="false" slots="Any,RightHand,LeftHand" aimpos="32,15" holdangle="0" aimangle="70" aimable="false" msg="ItemMsgPickUpSelect">
      <StatusEffect type="Always" target="This">
        <RemoveItem />
      </StatusEffect>
    </Holdable>
  </Item>
  <!-- "Monster Meat" -->
