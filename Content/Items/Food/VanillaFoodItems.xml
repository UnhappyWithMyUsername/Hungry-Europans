  <!-- TODO: Do not touch plant products for now, we'll have to integrate them to gardening? -->
  <!-- "Halophyte Grain" -->
  <Item name="" identifier="halophytegrain" category="Misc" subcategory="food" maxstacksize="32" maxstacksizecharacterinventory="8" Tags="smallitem,plantitem,fooditem,edibleplantitem,rawplantitem,biofuelprocessable" cargocontaineridentifier="metalcrate" scale="0.5" impactsoundtag="impact_soft" allowasextracargo="true">
    <Sprite texture="%ModDir%/Content/Items/BladderKelp.png" depth="0.2" sourcerect="896,448,64,64" origin="0.5,0.5" />
    <Body radius="15" height="15" density="10.1" />
    <Price baseprice="30" sold="false">
      <Price storeidentifier="merchantoutpost" />
      <Price storeidentifier="merchantcity" multiplier="1.2" />
      <Price storeidentifier="merchantresearch" multiplier="1.1" />
      <Price storeidentifier="merchantmilitary" multiplier="0.8" />
      <Price storeidentifier="merchantmine" multiplier="0.75" />
    </Price>
    <Deconstruct time="30">
      <Item identifier="carbon" mincondition="0.5" />
      <Item identifier="halophytegrainseed" mincondition="0.5" />
    </Deconstruct>
    <PreferredContainer primary="plantcontainer" secondary="foodcontainer" />
    <PreferredContainer secondary="medfabcab,storagecab,outpoststoragecab,outpostcrewcabinet" />
    <Holdable canBeCombined="false" slots="Any,RightHand,LeftHand" handle1="0,0" msg="ItemMsgPickUpSelect" />
  </Item>
  
  <!-- "Green Grasp" -->
  <Item name="" identifier="greengrasp" category="Misc" subcategory="food" maxstacksize="32" maxstacksizecharacterinventory="8" Tags="smallitem,plantitem,fooditem,edibleplantitem,rawplantitem,biofuelprocessable" cargocontaineridentifier="metalcrate" scale="0.5" impactsoundtag="impact_soft" allowasextracargo="true" useinhealthinterface="true">
    <Sprite texture="%ModDir%/Content/Items/BladderKelp.png" depth="0.2" sourcerect="960,448,64,64" origin="0.5,0.5" />
    <Body radius="15" height="15" density="10.1" />
    <Price baseprice="30" sold="false">
      <Price storeidentifier="merchantoutpost" />
      <Price storeidentifier="merchantcity" multiplier="1.2" />
      <Price storeidentifier="merchantresearch" multiplier="1.1" />
      <Price storeidentifier="merchantmilitary" multiplier="0.8" />
      <Price storeidentifier="merchantmine" multiplier="0.75" />
    </Price>
    <Deconstruct time="30">
      <Item identifier="carbon" mincondition="0.5" />
      <Item identifier="greengraspseed" mincondition="0.5" />
    </Deconstruct>
    <PreferredContainer primary="plantcontainer" secondary="foodcontainer" />
    <PreferredContainer secondary="medfabcab,storagecab,outpoststoragecab,outpostcrewcabinet" />
    <Holdable canBeCombined="false" characterusable="false" slots="Any,RightHand,LeftHand" aimpos="32,15" holdangle="0" aimangle="90" aimable="false" msg="ItemMsgPickUpSelect">
      <StatusEffect type="OnSecondaryUse" target="This" Condition="-25.0">
        <Sound file="Content/Items/Medical/ITEM_eatingLoop.ogg" range="250" loop="true" />
        <ParticleEmitter particle="brownchunks" AngleMin="-10" AngleMax="10" DistanceMin="2.5" DistanceMax="-2.5" VelocityMin="20" VelocityMax="30" ScaleMin="0.08" ScaleMax="0.1" EmitInterval="1.5" ParticleAmount="10" InitialDelay="0.3" CopyEntityAngle="True" ColorMultiplier="255,255,255,255" LifeTimeMultiplier="0.75" />
      </StatusEffect>
      <StatusEffect type="OnSecondaryUse" target="This,Character" disabledeltatime="true">
        <Conditional Condition="lte 1" />
        <Use />
      </StatusEffect>
      <StatusEffect type="OnUse" target="This">
        <Conditional Condition="gt 1" />
        <Sound file="Content/Items/Medical/ITEM_eatingBiteQuick.ogg" range="250" />
      </StatusEffect>
      <StatusEffect type="OnUse" target="This" Condition="-100.0" setvalue="true" />
      <StatusEffect type="OnUse" target="UseTarget" duration="5.0">
        <Affliction identifier="nourished" amount="1" />
      </StatusEffect>
      <StatusEffect type="OnUse" target="UseTarget" delay="5" stackable="false" disabledeltatime="true">
        <Affliction identifier="nausea" amount="25.0" probability="0.25" />
      </StatusEffect>
      <StatusEffect type="OnBroken" target="This">
        <Remove />
      </StatusEffect>
    </Holdable>
  </Item>
  
  
