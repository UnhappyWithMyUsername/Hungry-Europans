    <Item identifier="mechanicsworkstation" descriptionidentifier="mechanicsworkstation" spritecolor="255,255,255,255" category="Misc" Tags="workstation,mechanicfabricator" scale="0.5" isshootable="true" GrabWhenSelected="true">
      <sprite texture="Content/Items/Workstations/workstations.png" sourcerect="0,336,416,336" depth="0.75" premultiplyalpha="false" origin="0.5,0.5" />
      <WorkstationComponent OverridingJobIdentifier="mechanic"
                            MenuOrder="4"
                            JobTitle="dwellerjob.mechanic"
                            ConversationEventIdentifier="mechanicconversation"
                            ConversationSpeakerTag="outpostmechanic"
                            ItemsToEquipOptional="mechanicoutfit" 
                            IndicatorColor="0.5,0.86,0.9" 
                            ResourceUIIdentifier="producedgoods"
                            SkillIdentifier="mechanical"
                            SkillIncreasePerWorldStep="100.0">
        <!-- Note: we don't define any assigned orders above, like
            OrdersToAssign="repairmechanical;fixleaks;refuelitems" 
            That would just force the bot to keep doing the last one, as if they'd been manually assigned that as the 1st prio order.
            We can just let the bot do the autonomous objectives of the mechanic job, which includes the above. -->
        <ResourceGenerator>
          <!-- convert all yeast shrooms to ethanol -->
          <ConvertItem resource="goods_essentials_raw" OutputResource="ethanol">
            <ConsumedItem item="yeastshroom"/>
            <ProducedItem item="ethanol" amount="3"/>
          </ConvertItem>
          <!-- if there's less than 3 welding fuel tanks available, convert ethanol to tanks (= mechanic's fabricate new tanks) -->
          <ConvertItem resource="ethanol" OutputResource="goods_essentials">
            <ConsumedItem item="ethanol"/>
            <ProducedItem item="weldingfueltank"/>            
          </ConvertItem>
          <ProducedResource identifier="goods_essentials" AmountAtMinSkill="1" AmountAtMaxSkill="4" >
            <ItemResourceItem item="oxygentank" />
            <Requirement item="oxygentank" condition="lt 12"/>
          </ProducedResource>
          <ProducedResource identifier="workstation_goods" AmountAtMinSkill="0.1" AmountAtMaxSkill="0.4">
            <ItemResourceItem item="weldingtool" />
            <Requirement item="weldingtool" condition="lt 8"/>
          </ProducedResource>
          <ProducedResource identifier="workstation_goods" AmountAtMinSkill="0.1" AmountAtMaxSkill="0.4">
            <ItemResourceItem item="divingmask" />
          </ProducedResource>
        </ResourceGenerator>
      </WorkstationComponent>
    </Item>

    <Item identifier="electriciansworkstation" descriptionidentifier="electriciansworkstation" spritecolor="255,255,255,255" category="Misc" Tags="workstation,electricianfabricator" scale="0.5" isshootable="true" GrabWhenSelected="true" allowedlinks="locker">
      <sprite texture="Content/Items/Workstations/workstations.png" sourcerect="1200,0,416,336" depth="0.75" premultiplyalpha="false" origin="0.5,0.5" />
      <WorkstationComponent
        OverridingJobIdentifier="engineer"
        JobTitle="dwellerjob.engineer" 
        MenuOrder="4"
        ItemsToEquipOptional="engineeroutfit"
        ItemsToCarryOptional="reactorfuel gt 1"
        IndicatorColor="0.88,0.72,0.43"
        ResourceUIIdentifier="producedgoods"
        SkillIdentifier="electrical"
        SkillIncreasePerWorldStep="100.0">
        <!-- Note: we don't assign any orders above, the bot just does an engineer's objectives (see the comment in the mechanic's workstation -->
        <ResourceGenerator>
          <!-- Produced amount of advanced fuel has to be higher because of the itemratio value of 0.5 (1 rod = 2 fuel) -->
          <ConvertItem resource="goods_mining" OutputResource="basicfuel">
            <ConsumedItem item="uranium" Amount="1" />
            <ProducedItem item="fuelrod" Amount="1" />
          </ConvertItem>
          <ConvertItem resource="goods_mining" OutputResource="advancedfuel">
            <ConsumedItem item="thorium" Amount="1" />
            <ProducedItem item="thoriumfuelrod" Amount="2" />
          </ConvertItem>
          <ConvertItem resource="goods_mining" OutputResource="advancedfuel">
            <ConsumedItem item="fulgurium" Amount="1" />
            <ProducedItem item="fulguriumfuelrod" Amount="2" />
          </ConvertItem>
          <ProducedResource identifier="workstation_goods" AmountAtMinSkill="0.1" AmountAtMaxSkill="0.4">
            <ItemResourceItem item="batterycell" />
            <Requirement item="batterycell" condition="lt 8"/>
          </ProducedResource>
          <ProducedResource identifier="workstation_goods" AmountAtMinSkill="1" AmountAtMaxSkill="4" DisplayNameTag="entityname.wire">
            <ItemResourceItem item="electricalwire" />
          </ProducedResource>
        </ResourceGenerator>
      </WorkstationComponent>
      <Fabricator canbeselected="true" powerconsumption="0.0" msg="ItemMsgInteractSelect" ShowSortByDropdown="false" ShowCategoryButtons="false">
        <GuiFrame relativesize="0.4,0.5" style="ItemUI" anchor="Center" />
        <sound file="Content/Items/Fabricators/Fabricator.ogg" type="OnActive" range="200.0" loop="true"/>
      </Fabricator>
      <ItemContainer capacity="3" canbeselected="true" hideitems="true" slotsperrow="3" uilabel="" allowuioverlap="true"/>
      <ItemContainer capacity="1" canbeselected="true" hideitems="true" slotsperrow="1" uilabel="" allowuioverlap="true"/>
    </Item>

    <Item identifier="fisherworkstation" descriptionidentifier="fisherworkstation" spritecolor="255,255,255,255" category="Misc" Tags="workstation,harpoongunholder,fishcontainer" scale="0.5" isshootable="true" GrabWhenSelected="true">
      <sprite texture="Content/Items/Workstations/workstations.png" sourcerect="416,336,416,336" depth="0.75" premultiplyalpha="false" origin="0.5,0.5" />
      <WorkstationComponent
        OverridingJobIdentifier="outpostdweller"
        MenuOrder="3"
        IndicatorColor="0,170,148,255"
        AllowOperateOutside="true"
        ItemsRequiredForResourceGeneration="harpoongun;deepdiving"
        ItemsToEquip="harpoongun"
        CantFindItemsToEquipIdentifier="dialogcannotfinditemtoequip.fishing"
        ItemsToCarry="oxygensource gte 100"
        ItemsToCarryOptional="divingknife"
        ItemsToDrop="oxygensource lt 100"
        CantFindItemsToCarryIdentifier="dialogcannotfinditemtocarry.fishing"
        OrdersToAssign="exploreoutside"
        OrderReassignmentInterval="60"
        OrdersRequireIdle="true"
        JobTitle="dwellerjob.fisher"
        MaxAssignedNPCs="1"
        SkillIdentifier="weapons"
        SkillIncreasePerWorldStep="100.0">
        <!-- Each workstation reduces the production of the next by 50%. 
        Food consumption is Population/3, so one fish feeds three people. Two maximum skill dwellers can produce 6 fish/workshift, meaning sustaining 18 population
        Low skill dwellers (which is more likely) can sustain 9 population (if there are two)
        More efficient would be to have just one fisher who sustains 6 population to 12 population on their own, depending on skill -->
        <ResourceGenerator diminishingreturnid="fisherworkstation" diminishingreturn="0.5">
          <ProducedResource identifier="rawfish" AmountAtMinSkill="2" AmountAtMaxSkill="4" biomes="coldcaverns">
            <ItemResourceItem item="ferrulusflesh" />
            <ItemResourceItem item="illusoroidmantle" />
          </ProducedResource>
          <ProducedResource identifier="rawfish" AmountAtMinSkill="2" AmountAtMaxSkill="4" biomes="europanridge">
            <ItemResourceItem item="ferrulusflesh" />
            <ItemResourceItem item="illusoroidmantle" />
            <ItemResourceItem item="tatterfishfillet" />
          </ProducedResource>
          <ProducedResource identifier="rawfish" AmountAtMinSkill="2" AmountAtMaxSkill="4" biomes="theaphoticplateau">
            <ItemResourceItem item="illusoroidmantle" />
            <ItemResourceItem item="tatterfishfillet" />
            <ItemResourceItem item="charybtentacle" />
          </ProducedResource>
          <ProducedResource identifier="rawfish" AmountAtMinSkill="2" AmountAtMaxSkill="4" biomes="thegreatsea">
            <ItemResourceItem item="charybtentacle" />
            <ItemResourceItem item="ashacleviscera"/>
          </ProducedResource>
          <ProducedResource identifier="rawfish" AmountAtMinSkill="2" AmountAtMaxSkill="4" biomes="hydrothermalwastes">
            <ItemResourceItem item="ashacleviscera"/>
          </ProducedResource>
        </ResourceGenerator>
      </WorkstationComponent>
      <ItemContainer capacity="6" slotsperrow="3" canbeselected="true" msg="ItemMsgInteractSelect" SpawnWithId="harpoongun,divingknife" SpawnWithIdOnce="true">
        <GuiFrame relativesize="0.2,0.2" anchor="Center" style="ItemUI" />
        <Containable items="smallitem,mediumitem" />
      </ItemContainer>
    </Item>

