    <Item identifier="doctorsworkstation" descriptionidentifier="doctorsworkstation" spritecolor="255,255,255,255" category="Misc" Tags="workstation" scale="0.5" isshootable="true" GrabWhenSelected="true">
      <Sprite texture="Content/Items/Workstations/workstations.png" sourcerect="416,0,416,336" depth="0.75" premultiplyalpha="false" origin="0.5,0.5"/>
      <WorkstationComponent OverridingJobIdentifier="dweller_medicaldoctor" 
                            JobTitle="dwellerjob.doctor"
                            ItemsToEquipOptional="medicoutfit" 
                            CampaignInteractionType="MedicalClinic" 
                            IndicatorColor="0.81,0.31,0.19"
                            SkillIdentifier="medical"
                            SkillIncreasePerWorldStep="100.0">
        <ResourceGenerator>
          <ConvertItem resource="goods_essentials_raw" OutputResource="workstation_goods">
            <ConsumedItem item="aquaticpoppy" Amount="1" />
            <ProducedItem item="opium" Amount="3" />
          </ConvertItem>
          <ConvertItem resource="goods_essentials_raw" OutputResource="workstation_goods">
            <ConsumedItem item="fiberplant" Amount="1" />
            <ProducedItem item="organicfiber" Amount="3" />
          </ConvertItem>
          <ConvertItem resource="workstation_goods" OutputResource="goods_essentials">
            <ConsumedItem item="organicfiber" Amount="1" />
            <ProducedItem item="antibleeding1" Amount="2" />
          </ConvertItem>
          <ConvertItem resource="goods_essentials_raw" OutputResource="workstation_goods">
            <ConsumedItem item="slimebacteria" Amount="1" />
            <ProducedItem item="antibiotics" Amount="3" />
          </ConvertItem>
          <ConvertItem resource="goods_essentials_raw" OutputResource="workstation_goods">
            <ConsumedItem item="elastinplant" Amount="1" />
            <ProducedItem item="elastin" Amount="3" />
          </ConvertItem>
          <!-- Base generation (ensures at least a base amount of medicines are generated)-->
          <ProducedResource identifier="workstation_goods" AmountAtMinSkill="0.5" AmountAtMaxSkill="3" displaynametag="tags.medical">
            <ItemResourceItem item="opium" />
            <ItemResourceItem item="antibleeding1" />
            <ItemResourceItem item="antibloodloss1" />
          </ProducedResource>
        </ResourceGenerator>
      </WorkstationComponent>
